# ── Azure / Foundry ───────────────────────────────────────────────────────────
# Get your Foundry Project ID from Azure AI Foundry
FOUNDRY_PROJECT_ID=your-foundry-project-id-here
AZURE_AIPROJECT_ENDPOINT=https:
OPENAI_API_BASE=

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get your Google API key from https://ai.google.dev/
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# ── xAI / Grok ────────────────────────────────────────────────────────────────
# Get your xAI API key from https://console.x.ai/
XAI_API_KEY=your-xai-api-key-here
OPENAI_API_KEY=your-xai-api-key-here

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Get your OpenRouter key from https://openrouter.ai/
OPENROUTER_API_KEY=your-openrouter-key-here

# ── Anthropic / Claude ────────────────────────────────────────────────────────
# Get your Anthropic API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-key-here

# ── HuggingFace ───────────────────────────────────────────────────────────────
# Get your HuggingFace token from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your-hf-key-here

# ── Engine Config ─────────────────────────────────────────────────────────────
JL_MCP_PORT=8002
JL_MCP_TRANSPORT=stdio
JL_LOCAL_UNSAFE_TOOLS=0
JL_PLATFORM_ALLOW_NETWORK=1
JL_ENGINE_CLI_AUTO_APPROVE=1

# ── JL Engine Backend (Grok/xAI Testing) ───────────────────────────────────
# Choose your backend: openai (for xAI/Grok), ollama-local, google-gemini, openrouter
JL_ENGINE_BRAIN_BACKEND=openai
JL_ENGINE_TOOL_BACKEND=openai
JL_OPENAI_MODEL=grok-3
JL_OPENAI_BASE_URL=https://api.x.ai/v1
OPENAI_API_KEY=your-xai-api-key-here
