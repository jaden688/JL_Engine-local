# Optional backend selection
JL_ENGINE_BRAIN_BACKEND=ollama-local
JL_ENGINE_TOOL_BACKEND=ollama-local

# Optional model override (if unset, Ollama is resolved from installed local models)
JL_OLLAMA_MODEL=dolphin3:latest
JL_OPENAI_MODEL=gpt-5.2
JL_OPENROUTER_MODEL=openrouter/auto

# API keys (only needed for remote providers)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
