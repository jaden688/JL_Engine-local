{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jl-engine.dev/schemas/mpf/registry.schema.json",
  "$comment": "Copyright 2026 Jaden Lindenbach (https://github.com/jaden688/JL_Engine-local). Licensed under PolyForm Noncommercial 1.0.0. See LICENSE.md.",
  "title": "MPF Registry Schema (Open Standard)",
  "description": "Schema for JL_Agents.mpf.json registry maps.",
  "type": "object",
  "patternProperties": {
    "^.+$": {
      "type": "object",
      "anyOf": [
        { "required": ["jl_agent_file"] },
        { "required": ["agent_file"] }
      ],
      "properties": {
        "jl_agent_file": {
          "type": "string",
          "minLength": 1,
          "description": "Relative file path to a jl-agent JSON/MPF payload."
        },
        "agent_file": {
          "type": "string",
          "minLength": 1,
          "description": "Legacy alias for jl_agent_file."
        },
        "default_memory_mode": {
          "type": "string"
        },
        "default_backend_id": {
          "type": "string"
        },
        "drive_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schema_version": {
          "type": "string"
        },
        "schema_url": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
