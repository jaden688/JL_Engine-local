{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jl-engine.dev/schemas/mpf/agent.schema.json",
  "title": "MPF Agent Schema (Open Standard)",
  "description": "Open Modular Agent Framework schema. Supports both canonical MPF blocks and legacy JL agent fields.",
  "type": "object",
  "properties": {
    "mpf_spec_version": {
      "type": "string",
      "description": "MPF spec version used by this agent payload."
    },
    "name": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "base_prompt": {
      "type": "string"
    },
    "identity": {
      "$ref": "#/definitions/identity"
    },
    "core_identity": {
      "$ref": "#/definitions/core_identity"
    },
    "behavior": {
      "$ref": "#/definitions/behavior"
    },
    "communication_style": {
      "$ref": "#/definitions/communication_style"
    },
    "linguistic_style": {
      "$ref": "#/definitions/linguistic_style"
    },
    "memory": {
      "$ref": "#/definitions/memory"
    },
    "gait": {
      "$ref": "#/definitions/mode_profile"
    },
    "rhythm": {
      "$ref": "#/definitions/mode_profile"
    },
    "aperture": {
      "$ref": "#/definitions/mode_profile"
    },
    "emotional_aperture": {
      "$ref": "#/definitions/emotional_aperture"
    },
    "engine_alignment": {
      "$ref": "#/definitions/loose_object"
    },
    "operational_behavioral_traits": {
      "$ref": "#/definitions/operational_behavioral_traits"
    },
    "cognitive_gears": {
      "$ref": "#/definitions/loose_object"
    },
    "cognitive_modes": {
      "$ref": "#/definitions/loose_object"
    },
    "emotion_palette": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/emotion_palette_entry"
      }
    },
    "llm_profiles": {
      "$ref": "#/definitions/llm_profiles"
    },
    "pacing_instructions": {
      "oneOf": [
        {
          "$ref": "#/definitions/string_list"
        },
        {
          "$ref": "#/definitions/loose_object"
        }
      ]
    },
    "rhythm_instructions": {
      "oneOf": [
        {
          "$ref": "#/definitions/string_list"
        },
        {
          "$ref": "#/definitions/loose_object"
        }
      ]
    },
    "output_pacing_instructions": {
      "oneOf": [
        {
          "$ref": "#/definitions/string_list"
        },
        {
          "$ref": "#/definitions/loose_object"
        }
      ]
    },
    "safety": {
      "$ref": "#/definitions/loose_object"
    },
    "behavioral_core": {
      "$ref": "#/definitions/loose_object"
    },
    "flip_flop_modes": {
      "$ref": "#/definitions/loose_object"
    },
    "game_context": {
      "$ref": "#/definitions/loose_object"
    },
    "meta": {
      "$ref": "#/definitions/loose_object"
    }
  },
  "anyOf": [
    {
      "required": [
        "identity"
      ]
    },
    {
      "required": [
        "core_identity"
      ]
    }
  ],
  "definitions": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "loose_object": {
      "type": "object",
      "additionalProperties": true
    },
    "identity": {
      "type": "object",
      "required": [
        "name",
        "role"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/non_empty_string"
        },
        "role": {
          "$ref": "#/definitions/non_empty_string"
        },
        "archetype": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "voice": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "source_scenario": {
          "type": "string"
        },
        "tags": {
          "$ref": "#/definitions/string_list"
        }
      },
      "additionalProperties": true
    },
    "core_identity": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "behavior": {
      "type": "object",
      "properties": {
        "core_directives": {
          "$ref": "#/definitions/string_list"
        },
        "directives": {
          "$ref": "#/definitions/string_list"
        },
        "rules": {
          "$ref": "#/definitions/string_list"
        },
        "constraints": {
          "$ref": "#/definitions/string_list"
        },
        "avoidances": {
          "$ref": "#/definitions/string_list"
        },
        "boundaries": {
          "$ref": "#/definitions/string_list"
        },
        "edge_behavior": {
          "$ref": "#/definitions/loose_object"
        },
        "tone": {
          "type": "string"
        },
        "scenario": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "communication_style": {
      "type": "object",
      "properties": {
        "voice": {
          "type": "string"
        },
        "agentlity": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/loose_object"
            }
          ]
        },
        "style_notes": {
          "$ref": "#/definitions/string_list"
        }
      },
      "additionalProperties": true
    },
    "linguistic_style": {
      "type": "object",
      "properties": {
        "fluency": {
          "type": "string"
        },
        "rhythm": {
          "type": "string"
        },
        "style_tokens": {
          "$ref": "#/definitions/string_list"
        },
        "profanity_allowed": {
          "type": "boolean"
        },
        "cultural_influences": {
          "$ref": "#/definitions/string_list"
        }
      },
      "additionalProperties": true
    },
    "memory": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "mode_profile": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "tonal_range": {
          "$ref": "#/definitions/string_list"
        },
        "signature_moves": {
          "$ref": "#/definitions/string_list"
        }
      },
      "additionalProperties": true
    },
    "emotional_aperture": {
      "type": "object",
      "properties": {
        "modes": {
          "$ref": "#/definitions/loose_object"
        }
      },
      "additionalProperties": true
    },
    "operational_behavioral_traits": {
      "type": "object",
      "properties": {
        "positive": {
          "$ref": "#/definitions/string_list"
        },
        "negative": {
          "$ref": "#/definitions/string_list"
        },
        "boundaries": {
          "$ref": "#/definitions/string_list"
        }
      },
      "additionalProperties": true
    },
    "emotion_palette_entry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "score_range": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "intensity": {
          "type": "number"
        },
        "sentiment": {
          "type": "string"
        },
        "sampling_bias": {
          "$ref": "#/definitions/loose_object"
        }
      },
      "additionalProperties": true
    },
    "llm_profile": {
      "type": "object",
      "properties": {
        "boot_prompt": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "llm_profiles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/llm_profile"
      }
    }
  },
  "additionalProperties": true
}
