{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 1,
  "mcp": {
    "sparkbyte": {
      "type": "local",
      "command": ["python", "mcp_server/server.py"],
      "cwd": ".",
      "enabled": true,
      "timeout": 5000
    },
    "sparkbyte-teamwork": {
      "type": "local",
      "command": ["python", "mcp_server/teamwork_server.py"],
      "cwd": ".",
      "enabled": true,
      "timeout": 5000
    }
  },
  "tools": {
    "sparkbyte_*": false,
    "sparkbyte_get_engine_state": true,
    "sparkbyte_get_telemetry": true,
    "sparkbyte_list_agents": true,
    "sparkbyte_list_forged_tools": true,
    "sparkbyte_query_memory": true,
    "sparkbyte_get_knowledge": true
  },
  "agent": {
    "team-lead": {
      "mode": "primary",
      "steps": 8,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": {
          "*": "deny",
          "team-researcher": "allow",
          "team-verifier": "allow"
        }
      }
    }
  }
}
